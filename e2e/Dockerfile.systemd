# A throwaway Ubuntu 24.04 server with REAL systemd (PID 1) and a REAL firewall (ufw), for M14 (firewall,
# lockout protection). Needs a privileged container (see docker-compose.yml): systemd wants cgroups, and the
# firewall rules live in the container's own network namespace, so locking yourself out of it is real.
FROM ubuntu:24.04
ENV container=docker DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      systemd systemd-sysv dbus openssh-server sudo ufw iptables nftables iproute2 curl ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd \
    && useradd -m -s /bin/bash gfv \
    && echo 'gfv ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/gfv \
    && sed -i 's/^#\?PasswordAuthentication.*/PasswordAuthentication no/' /etc/ssh/sshd_config \
    && rm -f /etc/ssh/ssh_host_* \
    && systemctl enable ssh \
    && systemctl mask getty.target console-getty.service systemd-logind.service
COPY keys/id_test.pub /tmp/id_test.pub
RUN mkdir -p /home/gfv/.ssh && cp /tmp/id_test.pub /home/gfv/.ssh/authorized_keys \
    && chown -R gfv:gfv /home/gfv/.ssh && chmod 700 /home/gfv/.ssh && chmod 600 /home/gfv/.ssh/authorized_keys
# Host keys are generated on first boot (so a recreated container is a "new server").
RUN printf '[Unit]\nDescription=Generate SSH host keys\nBefore=ssh.service\nConditionPathExists=!/etc/ssh/ssh_host_ed25519_key\n[Service]\nType=oneshot\nExecStart=/usr/bin/ssh-keygen -A\n[Install]\nWantedBy=multi-user.target\n' > /etc/systemd/system/gfv-hostkeys.service \
    && systemctl enable gfv-hostkeys.service
EXPOSE 22
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
